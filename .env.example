# ==============================================================================
# AI JOB HUNTER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development or configure in Vercel.
# NEVER commit `.env.local` or actual secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC VARIABLES (Safe for browser bundle — RLS enforced in Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supports both Supabase Publishable Key (sb_publishable_...) and Legacy Anon Key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Privileged Supabase admin key used only in trusted server routes (cron/storage)
SUPABASE_SERVICE_ROLE_KEY=

# Primary AI Provider — Groq Cloud 100% Free Developer Tier (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary AI Provider — Google Gemini 100% Free Tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Job Discovery — Adzuna API (https://developer.adzuna.com/)
# Note: Public feeds (Remotive, Arbeitnow, SmartRecruiters, Greenhouse, Lever, Ashby)
# work without keys; Adzuna unlocks additional regional aggregator search.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Email Delivery — Google OAuth 2.0 for Gmail API (https://console.cloud.google.com/)
# Redirect URI: ${APP_URL}/api/email/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Server SMTP Fallback Provider (users can also connect Gmail App Password encrypted directly in /emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Platform Security & Scheduling
APP_URL=http://localhost:3000
# Random 32+ char bearer secret used by Vercel Cron to authenticate /api/cron/discover
CRON_SECRET=
# 64-character hex (32 bytes) key for AES-256-GCM encryption of OAuth tokens at rest
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
